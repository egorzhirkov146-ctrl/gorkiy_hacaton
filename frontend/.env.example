# true: работающий локальный демонстрационный чат и поиск по CSV.
# false: запросы отправляются на реальный API.
VITE_DEMO_MODE=true

# HTTP-сервер backend. В dev Vite проксирует /api/ на этот адрес.
# URL должен быть доверенным. Не храните API-ключи в frontend.
VITE_BACKEND_URL=http://localhost:8000

# Необязательно: полный публичный URL API для prod; по умолчанию /api.
# В dev оставьте /api, чтобы использовать Vite proxy.
VITE_API_BASE_URL=/api
